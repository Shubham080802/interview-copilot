# --- AI (required for real AI interviews; without it the app runs in Demo mode) ---
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# --- Zoom (optional) ---
# Create a "Server-to-Server OAuth" app at https://marketplace.zoom.us with the
# meeting:write:meeting scope, then paste its credentials here. When set, every
# interview session gets its own Zoom meeting link.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
