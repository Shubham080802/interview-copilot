# --- AI (required for real AI interviews; without it the app runs in Demo mode) ---
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# --- Zoom (optional) ---
# Create a "Server-to-Server OAuth" app at https://marketplace.zoom.us with the
# meeting:write:meeting scope, then paste its credentials here. When set, every
# interview session gets its own Zoom meeting link.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Login (optional) ---
# Adds sign-in. Create a free application at https://clerk.com and paste its keys below. Everyone
# who signs in gets their own private profile and interview history — nothing is shared between
# accounts. Leave these blank and the app stays open with a single shared profile, as it runs today.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# One-time migration only: if you were already using the app before adding login, put the email
# you'll sign in with here. The first time that email signs in, your existing profile and interview
# history are moved onto that account. Safe to leave set afterwards — it has no effect once claimed.
ALLOWED_EMAILS=
