# --- AI (required for real AI interviews; without it the app runs in Demo mode) ---
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# --- Zoom (optional) ---
# Create a "Server-to-Server OAuth" app at https://marketplace.zoom.us with the
# meeting:write:meeting scope, then paste its credentials here. When set, every
# interview session gets its own Zoom meeting link.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Login (optional) ---
# Protects the whole app behind sign-in. Create a free application at https://clerk.com, paste its
# keys below, then in the Clerk Dashboard go to "Restrictions" and set sign-up to "Restricted",
# adding only your own email — that is what actually stops anyone else from creating an account.
# Leave these blank and the app stays open, exactly as it runs today.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional extra check: comma-separated emails let past the "Access restricted" screen once signed
# in. Leave unset to rely on the Clerk Dashboard restriction above by itself.
ALLOWED_EMAILS=
